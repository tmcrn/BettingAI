# Copy this file to ".env" (same folder) and fill in real values - .env is
# gitignored, this .example file is the only one committed. Program.cs
# loads .env at boot, before anything else reads these, so every secret
# this app needs lives in one place instead of scattered across shell
# profiles/systemd units/launch scripts that are easy to lose track of.
#
# A variable already set in the real OS environment always wins over this
# file, so a real deploy can still set secrets the usual way instead, if
# ever preferred.

# Required - the app can't call the AI at all without this. Free key, no
# credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional - only set these if you need something other than the defaults.
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Required for real match data - football-data.org free API key:
# https://www.football-data.org/client/register (then find it in your
# account dashboard). Note the double underscore - that's how ASP.NET
# Core maps a flat env var name to the nested "FootballData:ApiKey"
# config key used in appsettings.json.
FootballData__ApiKey=

# Optional - Discord webhook URL for cycle/settlement notifications. Leave
# blank to just not get any.
# Discord__WebhookUrl=

# Optional - protects every POST/DELETE endpoint with this token (see
# Services/OwnerAuth.cs). Leave unset/blank while it's just you on your
# own private network (e.g. over Tailscale) - auth is deliberately OFF by
# default. Set a real long random value before ever exposing this app
# somewhere reachable by anyone else.
# OWNER_TOKEN=
