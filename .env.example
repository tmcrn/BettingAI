# Copy this file to ".env" (same folder) and fill in real values - .env is
# gitignored, this .example file is the only one committed. Program.cs
# loads .env at boot, before anything else reads these, so every secret
# this app needs lives in one place instead of scattered across shell
# profiles/systemd units/launch scripts that are easy to lose track of.
#
# A variable already set in the real OS environment always wins over this
# file, so a real deploy can still set secrets the usual way instead, if
# ever preferred.

# Required - the app can't call the AI at all without this. Free key, no
# credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional - only set these if you need something other than the defaults.
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Required for real match data - football-data.org free API key:
# https://www.football-data.org/client/register (then find it in your
# account dashboard). Note the double underscore - that's how ASP.NET
# Core maps a flat env var name to the nested "FootballData:ApiKey"
# config key used in appsettings.json.
FootballData__ApiKey=

# Optional - Discord webhook URL for cycle/settlement notifications. Leave
# blank to just not get any.
# Discord__WebhookUrl=

# Optional - protects every POST/DELETE endpoint with this token (see
# Services/OwnerAuth.cs). Leave unset/blank while it's just you on your
# own private network (e.g. over Tailscale) - auth is deliberately OFF by
# default. Set a real long random value before ever exposing this app
# somewhere reachable by anyone else.
# OWNER_TOKEN=

# Required for betting - real bookmaker odds from The Odds API. Free key,
# no credit card (500 credits/month, a daily cycle uses ~2 credits per
# league that has matches): https://the-odds-api.com
THE_ODDS_API_KEY=

# Optional - bookmaker you actually bet on, and the "sharp" reference
# bookmaker whose margin-free prices are used as the market's true view.
# ODDS_BOOKMAKER=winamax_fr
# ODDS_SHARP_BOOKMAKER=pinnacle

# Optional - starting balance of the app's simulated portfolio (default
# 10€). For paper trading ("en fictif"), set e.g. 100 and leave
# BETTING_BANKROLL unset: stakes then follow the simulated balance.
# BETTING_START_BALANCE=100

# Optional - your REAL betting bankroll in euros (what you set aside on
# the bookmaker). Stakes are a quarter-Kelly fraction of this. Unset = the
# app's own simulated balance (starts at 10€), which makes stakes tiny.
# BETTING_BANKROLL=100

# Optional - strategy knobs (defaults shown). See Services/BettingStrategy.cs.
# BETTING_MIN_EDGE=0.03          # minimum expected value to bet (3%)
# BETTING_MODEL_WEIGHT=0.5       # model vs market weight in the final probability
# BETTING_KELLY_FRACTION=0.25    # quarter Kelly
# BETTING_MAX_STAKE_SHARE=0.05   # max 5% of bankroll on one bet
# BETTING_MAX_CYCLE_SHARE=0.25   # max 25% of bankroll staked per cycle
# BETTING_MIN_ODDS=1.40
# BETTING_MAX_ODDS=4.00
# BETTING_MIN_STAKE=0.10
